{
  "name": "@webship-js/odoo-steps",
  "version": "2.0.1",
  "description": "Odoo step definitions for webship-js (Playwright and Cucumber): sessions and the users registry, apps and menus, the search, list, kanban and form views, dialogs, notifications, the chatter, access rights and the website.",
  "main": "tests/step-definitions/odoo.steps.js",
  "files": [
    "tests/step-definitions/",
    "README.md",
    "STEPS.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "docs:steps": "node tests/list-steps.js",
    "docs:steps:check": "node tests/list-steps.js --check",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports"
  },
  "keywords": [
    "webship-js",
    "odoo",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "gherkin",
    "step-definitions",
    "odoo-testing",
    "e2e-testing"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/odoo-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/odoo-steps/issues"
  },
  "homepage": "https://github.com/webship/odoo-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.6"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "webship-js": "^2.0.6"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
